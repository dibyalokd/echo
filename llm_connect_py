# ---- Backend selection (env-driven; add your own entries to the maps) -------
CHAT_BACKEND = os.getenv("CHAT_BACKEND", "lmstudio").lower()
EMBED_BACKEND = os.getenv("EMBED_BACKEND", "lmstudio").lower()

CHAT_BACKENDS = {
    "lmstudio": _lmstudio_chat,
    "custom": custom_chat_connect,
}
EMBED_BACKENDS = {
    "lmstudio": _lmstudio_embed,
    "custom": custom_embed_connect,
}


def chat_connect(messages: list[dict]) -> str:
    """Single entry point for ALL chat calls. Routes to the selected backend."""
    fn = CHAT_BACKENDS.get(CHAT_BACKEND)
    if fn is None:
        raise ValueError(
            f"Unknown CHAT_BACKEND '{CHAT_BACKEND}'. "
            f"Options: {sorted(CHAT_BACKENDS)}"
        )
    return fn(messages)


def embed_connect(text: str) -> list[float]:
    """Single entry point for ALL embedding calls. Routes to the selected backend."""
    fn = EMBED_BACKENDS.get(EMBED_BACKEND)
    if fn is None:
        raise ValueError(
            f"Unknown EMBED_BACKEND '{EMBED_BACKEND}'. "
            f"Options: {sorted(EMBED_BACKENDS)}"
        )
    return fn(text)


def backend_info() -> dict:
    """Which backends/models/endpoints are currently in use (for health checks)."""
    return {
        "chat_backend": CHAT_BACKEND,
        "embed_backend": EMBED_BACKEND,
        "chat_url": CHAT_BASE_URL if CHAT_BACKEND == "lmstudio" else "(custom)",
        "embed_url": EMBED_BASE_URL if EMBED_BACKEND == "lmstudio" else "(custom)",
        "chat_model": CHAT_MODEL,
        "embed_model": EMBED_MODEL,
    }

