# ---- Backend 1: LM Studio (default, OpenAI-compatible HTTP) -----------------
def _lmstudio_chat(messages: list[dict]) -> str:
    resp = httpx.post(
        f"{CHAT_BASE_URL}/chat/completions",
        json={"model": CHAT_MODEL, "messages": messages},
        timeout=REQUEST_TIMEOUT,
    )
    resp.raise_for_status()
    return resp.json()["choices"][0]["message"]["content"]


def _lmstudio_embed(text: str) -> list[float]:
    resp = httpx.post(
        f"{EMBED_BASE_URL}/embeddings",
        json={"model": EMBED_MODEL, "input": text},
        timeout=REQUEST_TIMEOUT,
    )
    resp.raise_for_status()
    return resp.json()["data"][0]["embedding"]


# ---- Adapters between this app's shapes and YOUR function signatures -------
def _messages_to_prompt(messages: list[dict]) -> str:
    """Flatten OpenAI-style messages into a single prompt string.

    Your connectLLM() takes a prompt, not a messages list, so this collapses
    the conversation into text. Image parts are noted but not inlined — pass
    images through your own API if connectLLM() supports them.
    """
    out = []
    for m in messages:
        role = m.get("role", "user")
        content = m.get("content")
        if isinstance(content, list):  # multimodal parts
            text = " ".join(p.get("text", "") for p in content if p.get("type") == "text")
            if any(p.get("type") == "image_url" for p in content):
                text += "\n[an image was attached]"
        else:
            text = content or ""
        out.append(text if role == "user" and len(messages) == 1 else f"{role}: {text}")
    return "\n\n".join(out).strip()


def _normalize_vector(v) -> list[float]:
    """Coerce an embedding result into ONE flat list of floats.

    Your connectEmbedLLM() returns a list of vectors, so if we get a batch
    (e.g. [[0.1, 0.2, ...]]) take the first vector. ChromaDB needs a flat list.
    """
    if v and isinstance(v[0], (list, tuple)):
        v = v[0]
    return [float(x) for x in v]


