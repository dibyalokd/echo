# --- Internal helpers ----------------------------------------------------
def _embed(text: str) -> list[float]:
    """Return the embedding vector for `text` via the selected embed backend."""
    return embed_connect(text)


def _encode_image(image_path: str | None, image_base64: str | None):
    if image_base64:
        if image_base64.startswith("data:"):
            header, _, payload = image_base64.partition(",")
            mime = header[5:].split(";")[0] or "image/png"
            return mime, payload
        return "image/png", image_base64
    if image_path:
        mime = mimetypes.guess_type(image_path)[0] or "image/png"
        with open(image_path, "rb") as fh:
            return mime, base64.b64encode(fh.read()).decode("utf-8")
    return None


# --- Chat (backend-agnostic) ---------------------------------------------
def query_llm(prompt, image_path=None, image_base64=None) -> str:
    """Send a prompt (and optionally an image) to the selected chat backend.

    Builds the OpenAI-style message and hands it to chat_connect(), so this
    works unchanged whether you're on LM Studio or your own on-prem server.
    """
    image = _encode_image(image_path, image_base64)
    if image is None:
        content: object = prompt
    else:
        mime, b64 = image
        content = [
            {"type": "text", "text": prompt},
            {"type": "image_url", "image_url": {"url": f"data:{mime};base64,{b64}"}},
        ]
    return chat_connect([{"role": "user", "content": content}])


# --- Failure-log storage + history --------------------------------------
def store_failure_log(testcase_id: str, log: str) -> dict:
    """Store one FAILURE log for a test case, with an automatic timestamp.

    Each call adds a NEW entry (history accumulates; nothing is overwritten).
    """
    vector = _embed(log)
    ts_iso, ts_epoch = _now()
    entry_id = f"{testcase_id}::{uuid.uuid4().hex[:12]}"
    _collection.add(
        ids=[entry_id],
        embeddings=[vector],
        documents=[log],
        metadatas=[{"testcaseId": testcase_id, "timestamp": ts_iso, "created_at": ts_epoch}],
    )
    return {
        "entryId": entry_id,
        "testcaseId": testcase_id,
        "timestamp": ts_iso,
        "dimensions": len(vector),
        "stored": True,
    }


def get_failure_history(testcase_id: str, limit: int = 50) -> dict:
    """Return all stored failure logs for one testcaseId, oldest to newest."""
    got = _collection.get(
        where={"testcaseId": testcase_id},
        include=["documents", "metadatas"],
        limit=limit,
    )
    entries = [
        {
            "testcaseId": testcase_id,
            "timestamp": meta.get("timestamp"),
            "created_at": meta.get("created_at"),
            "log": doc,
        }
        for doc, meta in zip(got["documents"], got["metadatas"])
    ]
    entries.sort(key=lambda e: e.get("created_at") or 0)
    return {"testcaseId": testcase_id, "count": len(entries), "history": entries}


def search_failures(query: str, n_results: int = 10, since_days: float | None = None) -> dict:
    """Semantically search failure logs across ALL test cases.

    Returns matching logs with their testcaseId and timestamp. Optionally limit
    to failures from the last `since_days` days.
    """
    count = _collection.count()
    if count == 0:
        return {"query": query, "matches": [], "note": "no failures stored"}
    vector = _embed(query)
    res = _collection.query(
        query_embeddings=[vector],
        n_results=min(n_results, count),
        where=_time_where(since_days),
        include=["documents", "metadatas", "distances"],
    )
    matches = [
        {
            "testcaseId": meta.get("testcaseId"),
            "timestamp": meta.get("timestamp"),
            "log": doc,
            "distance": dist,
        }
        for doc, meta, dist in zip(
            res["documents"][0], res["metadatas"][0], res["distances"][0]
        )
    ]
    return {"query": query, "matches": matches}


def list_recent_failures(limit: int = 50, since_days: float | None = None) -> dict:
    """List recent failure logs across all test cases (newest first).

    Useful for scanning many failures to spot common patterns. Optionally limit
    to the last `since_days` days.
    """
    got = _collection.get(
        where=_time_where(since_days),
        include=["documents", "metadatas"],
        limit=limit,
    )
    entries = [
        {
            "testcaseId": meta.get("testcaseId"),
            "timestamp": meta.get("timestamp"),
            "created_at": meta.get("created_at"),
            "log": doc,
        }
        for doc, meta in zip(got["documents"], got["metadatas"])
    ]
    entries.sort(key=lambda e: e.get("created_at") or 0, reverse=True)
    return {"count": len(entries), "failures": entries}
