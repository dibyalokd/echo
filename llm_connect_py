"""
LLM Connect + Failure-Log Vector Store
======================================
Talks to two locally hosted **LM Studio** endpoints (OpenAI-compatible):
  - CHAT_BASE_URL  : chat / vision model  (machine A)
  - EMBED_BASE_URL : embedding model      (machine B)

and stores software test **failure logs** in ChromaDB for historical analysis.

Storage model (one row PER failure, so history accumulates):
    ids        -> unique entry id  ("{testcaseId}::{random}")
    embeddings -> vector of the failure log (for similarity search)
    documents  -> the raw failure log text (so the model can read it back)
    metadatas  -> { testcaseId, timestamp (UTC ISO), created_at (epoch) }

The user supplies testcaseId + the failure log. The timestamp is added by the
backend automatically — it is not the user's responsibility. Only FAILURE logs
are stored (there is no pass/fail field; every record is a failure).

Environment variables:
    LMSTUDIO_CHAT_BASE_URL   default http://192.168.1.7:1234/v1   (fallback LMSTUDIO_BASE_URL)
    LMSTUDIO_EMBED_BASE_URL  default http://192.168.1.5:1234/v1
    LMSTUDIO_CHAT_MODEL      default "mistralai/ministral-3-3b"
    LMSTUDIO_EMBED_MODEL     default "text-embedding-nomic-embed-text-v1.5"
    CHROMA_COLLECTION        default "failure_logs"
"""

import base64
import datetime
import mimetypes
import os
import uuid

import chromadb
import httpx

# Two separate LM Studio endpoints (two machines).
CHAT_BASE_URL = os.getenv(
    "LMSTUDIO_CHAT_BASE_URL",
    os.getenv("LMSTUDIO_BASE_URL", "http://192.168.1.7:1234/v1"),
).rstrip("/")
EMBED_BASE_URL = os.getenv("LMSTUDIO_EMBED_BASE_URL", "http://192.168.1.5:1234/v1").rstrip("/")
CHAT_MODEL = os.getenv("LMSTUDIO_CHAT_MODEL", "mistralai/ministral-3-3b")
EMBED_MODEL = os.getenv("LMSTUDIO_EMBED_MODEL", "text-embedding-nomic-embed-text-v1.5")
COLLECTION_NAME = os.getenv("CHROMA_COLLECTION", "failure_logs")
REQUEST_TIMEOUT = float(os.getenv("LMSTUDIO_TIMEOUT", "120"))

_HERE = os.path.dirname(os.path.abspath(__file__))
CHROMA_DIR = os.getenv("CHROMA_DIR", os.path.join(_HERE, "chroma_db"))

_chroma_client = chromadb.PersistentClient(path=CHROMA_DIR)
_collection = _chroma_client.get_or_create_collection(name=COLLECTION_NAME)


# --- helpers -------------------------------------------------------------
def _now():
    """Return (iso_utc_string, epoch_seconds) for the current UTC time."""
    dt = datetime.datetime.now(datetime.timezone.utc)
    return dt.isoformat().replace("+00:00", "Z"), dt.timestamp()


def _time_where(since_days):
    """Chroma `where` clause for 'within the last N days', or None."""
    if not since_days:
        return None
    cutoff = (
        datetime.datetime.now(datetime.timezone.utc)
        - datetime.timedelta(days=float(since_days))
    ).timestamp()
    return {"created_at": {"$gte": cutoff}}


